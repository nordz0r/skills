# Atlassian Skills configuration
# Copy this file to `.env` in the same directory and fill in your values.
# Do NOT commit the real .env — it contains secrets.

# --- Jira Cloud (https://id.atlassian.com/manage-profile/security/api-tokens) ---
# JIRA_URL=https://your-company.atlassian.net
# JIRA_USERNAME=your.email@company.com
# JIRA_API_TOKEN=your_api_token

# --- Jira Data Center / Server (Profile -> Personal Access Tokens) ---
# JIRA_URL=https://jira.your-company.com
# JIRA_PAT_TOKEN=your_pat_token

# --- Confluence Cloud ---
# CONFLUENCE_URL=https://your-company.atlassian.net/wiki
# CONFLUENCE_USERNAME=your.email@company.com
# CONFLUENCE_API_TOKEN=your_api_token

# --- Confluence Data Center / Server ---
# CONFLUENCE_URL=https://confluence.your-company.com
# CONFLUENCE_PAT_TOKEN=your_pat_token

# --- Bitbucket Server / Data Center ---
# BITBUCKET_URL=https://bitbucket.your-company.com
# BITBUCKET_PAT_TOKEN=your_pat_token

# --- Optional: pin API version ('2' or '3'), auto-detected if unset ---
# JIRA_API_VERSION=2
# CONFLUENCE_API_VERSION=1

# --- Optional: verify TLS certificates (default: disabled for self-signed DC) ---
# JIRA_SSL_VERIFY=true
# CONFLUENCE_SSL_VERIFY=true
# BITBUCKET_SSL_VERIFY=true
